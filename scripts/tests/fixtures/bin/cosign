#!/usr/bin/env bash
# Test stub for cosign (scripts/tests only). Records argv; fails the first
# $STUB_COSIGN_FAILS calls (default 0).
set -euo pipefail
printf 'cosign %s\n' "$*" >> "${STUB_LOG:?}"
n=$(( $(cat "$STUB_LOG.cosign" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$STUB_LOG.cosign"
[ "$n" -le "${STUB_COSIGN_FAILS:-0}" ] && { echo "stub cosign: sign failed ($n)" >&2; exit 1; }
exit 0
