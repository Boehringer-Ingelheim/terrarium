# --------- Global args — single source of truth for all versions ---------
# Sorted alphabetically. Referenced by ARG in each stage that needs them.
# Base images pinned for build determinism. Keep both on the newest EL9 minor:
# Rocky point releases go EOL when the next one ships, and
# scripts/check-pin-freshness.sh (make guardrails) fails on a stale pin.
# Tools track their latest release built with a supported Go (INFIAAS-9587);
# GO_VERSION is freshness-checked too. TERRAFORM_VERSION is only the *default*:
# tenv (TENV_AUTO_INSTALL=true) installs whatever a project pins in
# .terraform-version or TFENV_TERRAFORM_VERSION, e.g. the ODS agent's 1.9.4.
ARG ROCKYLINUX_VERSION=9.8
ARG UBI9_VERSION=9.8
ARG AGE_VERSION=1.3.2
ARG AWS_CDK_VERSION=2.1024.0
ARG BATS_CORE_VERSION=1.13.0
ARG GO_VERSION=1.26.8
ARG HELM_VERSION=3.22.0
ARG KUBECTL_VERSION=1.35.9
ARG NODEJS_VERSION=24.21.0
# npm bundled with Node lags its own dependency fixes; pin it explicitly (INFIAAS-9587)
ARG NPM_VERSION=11.20.0
# Fixed releases swapped in for packages npm bundles, until npm ships them
# itself (INFIAAS-9587, docker/files/bin/npm_patch_bundled). Same major only.
ARG NPM_BUNDLED_PATCHES="undici@6.28.1 ip-address@10.7.1 brace-expansion@5.0.12"
ARG OC_VERSION=4.19.48
ARG OPENSTACK_RELEASE=2025.1
ARG OPENSTACK_VENV=/opt/openstack
ARG OPENTOFU_VERSION=1.13.1
ARG PACKER_VERSION=1.16.1
ARG PYTHON_VERSION=3.13.15
ARG SOPS_VERSION=3.13.3
ARG STARSHIP_VERSION=1.24.2
ARG TASK_VERSION=3.54.0
ARG TENV_VERSION=4.15.1
ARG TERRAFORM_DOCS_VERSION=v0.24.0
ARG TERRAFORM_VERSION=1.16.4
ARG TFLINT_VERSION=0.64.0
ARG TRIVY_VERSION=0.75.0
# ARG UV_VERSION=0.11.6 Defined in docker/pyproject.toml
ARG YQ_VERSION=4.54.1
ARG ZOXIDE_VERSION=0.9.9


# ================= Stage 0 — buildlang (compile on Rocky 9) =================
# docker.io/library/rockylinux is deprecated and stops at 9.3; the Rocky
# Enterprise Software Foundation publishes current point releases here.
FROM docker.io/rockylinux/rockylinux:${ROCKYLINUX_VERSION} AS buildlang
ARG PYTHON_VERSION

ENV PYENV_ROOT=/opt/pyenv
ENV PATH=${PYENV_ROOT}/shims:${PYENV_ROOT}/bin:$PATH

RUN dnf -y upgrade \
    && dnf -y install dnf-plugins-core \
    && dnf config-manager --set-enabled crb \
    && dnf -y groupinstall "Development Tools" \
    && dnf -y install \
    git wget tar patch which sudo procps diffutils xz unzip \
    gcc gcc-c++ make autoconf automake libtool bison \
    zlib zlib-devel bzip2 bzip2-devel xz xz-devel \
    openssl openssl-devel libffi libffi-devel \
    sqlite sqlite-devel \
    readline readline-devel gdbm gdbm-devel libuuid libuuid-devel \
    tk tk-devel \
    xorriso \
    && dnf clean all

# ---- pyenv & Python ----
RUN umask 0002 \
    && git clone https://github.com/pyenv/pyenv.git ${PYENV_ROOT} \
    && git clone https://github.com/pyenv/pyenv-update.git ${PYENV_ROOT}/plugins/pyenv-update \
    && ${PYENV_ROOT}/bin/pyenv install ${PYTHON_VERSION} \
    && ${PYENV_ROOT}/bin/pyenv global  ${PYTHON_VERSION} \
    && python --version && pip --version

# ---- Strip .git metadata from pyenv (saves space in the final image) ----
RUN rm -rf ${PYENV_ROOT}/.git ${PYENV_ROOT}/plugins/*/.git

# ================= Stage 1 — builder (UBI 9) =================
FROM registry.access.redhat.com/ubi9/ubi:${UBI9_VERSION} AS builder
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

LABEL maintainer="Erhard Wais <erhard.wais@boehringer-ingelheim.com>, Josef Hartmann <josef.hartmann@boehringer-ingelheim.com>"

ARG TARGETPLATFORM TARGETOS TARGETARCH TARGETVARIANT BUILDPLATFORM BUILDOS BUILDARCH BUILDVARIANT
# Pull in global args needed in this stage
ARG AGE_VERSION AWS_CDK_VERSION BATS_CORE_VERSION
ARG GO_VERSION HELM_VERSION KUBECTL_VERSION NODEJS_VERSION NPM_VERSION
ARG NPM_BUNDLED_PATCHES
ARG OC_VERSION OPENSTACK_RELEASE OPENSTACK_VENV
ARG OPENTOFU_VERSION PACKER_VERSION PYTHON_VERSION
ARG SOPS_VERSION STARSHIP_VERSION TASK_VERSION TENV_VERSION
ARG TERRAFORM_DOCS_VERSION TERRAFORM_VERSION
ARG TFLINT_VERSION TRIVY_VERSION YQ_VERSION ZOXIDE_VERSION
ARG DEVTOOLS_GID=2001

# Bake global ARGs into ENV so they're available in RUN steps and at runtime
ENV AGE_VERSION=${AGE_VERSION} \
    AWS_CDK_VERSION=${AWS_CDK_VERSION} \
    GO_VERSION=${GO_VERSION} \
    HELM_VERSION=${HELM_VERSION} \
    KUBECTL_VERSION=${KUBECTL_VERSION} \
    NODEJS_VERSION=${NODEJS_VERSION} \
    NPM_VERSION=${NPM_VERSION} \
    NPM_BUNDLED_PATCHES="${NPM_BUNDLED_PATCHES}" \
    OC_VERSION=${OC_VERSION} \
    OPENSTACK_RELEASE=${OPENSTACK_RELEASE} \
    OPENTOFU_VERSION=${OPENTOFU_VERSION} \
    PACKER_VERSION=${PACKER_VERSION} \
    PYTHON_VERSION=${PYTHON_VERSION} \
    SOPS_VERSION=${SOPS_VERSION} \
    STARSHIP_VERSION=${STARSHIP_VERSION} \
    TASK_VERSION=${TASK_VERSION} \
    TENV_AUTO_INSTALL=true \
    TENV_ROOT=/opt/tenv \
    TENV_VERSION=${TENV_VERSION} \
    TERRAFORM_DOCS_VERSION=${TERRAFORM_DOCS_VERSION} \
    TERRAFORM_VERSION=${TERRAFORM_VERSION} \
    TFLINT_VERSION=${TFLINT_VERSION} \
    TRIVY_VERSION=${TRIVY_VERSION} \
    YQ_VERSION=${YQ_VERSION} \
    ZOXIDE_VERSION=${ZOXIDE_VERSION}

# Fingerprints / key sources

# ───────────────────────────────── Key sources & update playbook ───────────────────────────────
# HashiCorp (signs *_SHA256SUMS and *_SHA256SUMS.sig on releases.hashicorp.com)
#   • Canonical fingerprint is published on HashiCorp’s Security page:
#       https://www.hashicorp.com/security  (look for the “PGP public key” section)
#     Example current fingerprint (no spaces): C874011F0AB405110D02105534365D9472D7468F
#   • Public key (ASCII armored) is served from the site’s well-known path:
#       https://www.hashicorp.com/.well-known/pgp-key.txt
#   • Deterministic fetch by fingerprint (alternate source):
#       https://keys.openpgp.org/vks/v1/by-fingerprint/<FPR>
#   Update steps:
#     1. Fetch the key from both the .well-known URL and keys.openpgp.org (by fingerprint).
#     2. Compute the fingerprint you fetched:
#          gpg --batch --with-colons --import-options show-only --import pgp-key.txt \
#             | awk -F: '/^fpr:/ {print $10; exit}'
#     3. Compare to the Security page. If HashiCorp rotates keys, update HASHICORP_PGP_FPR below
#        and commit a link to the rotation notice/release notes for traceability.
#
# OpenTofu (signs SHA256SUMS on GitHub releases; tenv verifies via PGP when cosign is absent)
#   • Canonical public key (ASCII armored) served by the OpenTofu project:
#       https://get.opentofu.org/opentofu.asc
#   • Current primary fingerprint (no spaces): E3E6E43D84CB852EADB0051D0C0AF313E5FD9F80
#     UID: OpenTofu (core@opentofu.org)
#   • Deterministic fetch by fingerprint (alternate source):
#       https://keys.openpgp.org/vks/v1/by-fingerprint/<FPR>
#   Update steps:
#     1. Fetch the key from both get.opentofu.org and keys.openpgp.org (by fingerprint).
#     2. Compute the fingerprint (same gpg command as above) and confirm both sources agree.
#     3. If OpenTofu rotates the key, update OPENTOFU_PGP_FPR below and link the rotation notice.
#
# AWS CLI v2 (zip installers are .sig-signed)
#   • Public key file:
#       https://awscli.amazonaws.com/AWSCLIV2.asc
#   • Official docs show the key’s Key ID and fingerprint and how to verify signatures:
#       https://docs.aws.amazon.com/cli/latest/userguide/install-cliv2-linux.html#v2-install-linux-validate
#     As documented there, the current fingerprint is:
#       FB5D B77F D5C1 18B8 0511 ADA8 A631 0ACC 4672 475C  (ID: A631 0ACC 4672 475C)
#   Update steps:
#     1. Download AWSCLIV2.asc from the AWS domain.
#     2. Compute fingerprint (same gpg command as above) and confirm it matches the doc.
#     3. If AWS rotates the key, pin the new fingerprint (optional) and reference the doc in the commit.
#
# Node.js (SHASUMS256.txt.sig is GPG-signed)
#   • Preferred: use the curated, maintained keyring from the official nodejs/release-keys repo:
#       https://github.com/nodejs/release-keys   (see README for the “gpg-only-active-keys” keyring)
#   • Also documented: the “Release keys” section in the nodejs/node README (historical list):
#       https://github.com/nodejs/node#release-keys
#   Update steps:
#     1. Periodically refresh the curated keyring from nodejs/release-keys (only-active set).
#     2. If you keep explicit fingerprints, reconcile them with the Release keys list and retire old ones.
#
# General guidance
#   • Prefer vendor-controlled sources (security/trust/install docs, .well-known paths).
#   • If you must pull from a keyserver, use keys.openpgp.org by fingerprint (owner-verified email),
#     not legacy SKS pools. Always PIN to a fingerprint you cross-checked on a vendor-controlled page.
#   • Keep this comment updated when vendors rotate keys, and link to the official announcement.
# ───────────────────────────────────────────────────────────────────────────────────────────────

ENV HASHICORP_PGP_FPR=C874011F0AB405110D02105534365D9472D7468F \
    OPENTOFU_PGP_FPR=E3E6E43D84CB852EADB0051D0C0AF313E5FD9F80 \
    AWS_CLI_PGP_URL="https://awscli.amazonaws.com/AWSCLIV2.asc" \
    AWS_CLI_PGP_FPR=FB5DB77FD5C118B80511ADA8A6310ACC4672475C \
    NODE_RELEASE_FPRS="\
    0912234647DD4B223F04152259EB1E31F56368C1 \
    0A178CD0FE03CB4F8780980A039F94E89826F891 \
    0EFFE1BCEFD9C84E3D098152933B01F40B5CA946 \
    108F52B48DB57BB0CC439B2997B01419BD92F80A \
    114F43EE0176B71C7BC219DD50A3051F888C628D \
    141F07595B7B3FFE74309A937405533BE57C7D57 \
    1A17FA90D972256AB021D5654ED91D4DBD94604D \
    1C050899334244A8AF75E53792EF661D867B9DFA \
    22E11EACBD7E5A2466BFCC5A85E7AF54D684A75F \
    265E38BB516DF5F945761AB7A39CBCAE8D765781 \
    26FFD37528D0DE0E6D4D1C1A7341B15C070877AC \
    2B2B9F0D620463DB3DE74C50DEA16371974031A5 \
    3E63B94525C8D3A358D9D1258975BA8B6100C6B1 \
    4104B1A1F784A8AE9E0C2A5105DE7928107F3DC0 \
    484CEE51DD8C99D2A75D96972248F59603A1688D \
    4BE2629F5FC285B8AB08AEDA919AC8A92C482931 \
    4ED778F539E3634C779C87C6D7062848A1AB005C \
    50CBD045680704B1B723693545F5EEBD813DAE8E \
    5428A566947692736F60E5F6D3C55C2AAEC2131D \
    56730D5401028683275BD23C23EFEFE93C4CFFFE \
    59FE5759A5D617A2AB026435A250501325FA7297 \
    5BE8A3F6C8A5C01D106C0AD820B1A390B168D356 \
    61FC681DFB92A079F1685E77973F295594EC4689 \
    65AEF21BAA3FE5766E3533221BDC911B8B6AED76 \
    65E4D04ADAD1F47B0991DA7C996B7490EF1AEF97 \
    699389B313B1D7C058A61713F320153C71827C7B \
    6A8DE9DC075798602EFD8833EE3D476257C362B1 \
    6E129FFB0180A9F444988C7F8CDB0392359F9454 \
    71DCFD284A79C3B38668286BC97EC7A07EDE3FC1 \
    74CD01639B02F3361D0918140D0792FB9ACAD426 \
    74F12602B6F1C4E913FAA37AD3A89613643B6201 \
    75C9C820E0B3C81082E0517FC06C369CA38E029B \
    77984A986EBC2AA786BC0F66B01FBB92821C587A \
    7937DFD2AB06298B2293C3187D33FF9D0246406D \
    7C1F423FA1A6C8F34C1C9924900A296076CFC675 \
    80E6380360B2E90F2C9A3AA6C0AB7FA4DC8F4063 \
    890C08DB8579162FEE0DF9DB8BEAB4DFCF555EF4 \
    8FCCA13FEF1D0C2E91008E09770F7A9A5AE15600 \
    93C7E9E91B49E432C2F75674B0A78B0A6C481CF6 \
    94AE36675C464D64BAFA68DD7434390BDBE9B9C5 \
    9554F04D7259F04124DE6B476D5A82AC7E37093B \
    9FC51CEA112B1655FA9398E2E04111EEE1A956A5 \
    A363A499291CBBC940DD62E41F10027AF002F8B0 \
    A48C2BEE680E841632CD4E44F07496B3EB3C1762 \
    A6023530FC53461FEC91F99C04CD3F2FDE079578 \
    AB782490DA6DB0E39DEBBAB33F4049298959D8C2 \
    B9AE9905FFD7803F25714661B63B535A4C206CA9 \
    B9E2F5981AA6E0CD28160D9FF13993A75599653C \
    C0D6248439F1D5604AAFFB4021D900FFDB233756 \
    C2B25D9B4272DB29565BA87F3C7824F39A895758 \
    C45CA36E926C99594C3A5A083049F7B98AED0C89 \
    C4960C6DAA2AEBC352F3E5B8E140F61BC5979DCC \
    C4F0DFFF4E8C1A8236409D08E73BC641CC11F4C8 \
    C6B38CFEAC5757BDE31202BC12DAF9ECEDE8123E \
    C82FA3AE1CBEDC6BE46B9360C43CEC45C17AB93C \
    CC68F5A3106FF448322E48ED27F5E38D5B0A215F \
    D9DB73DBB228C6B5636D9B49926EC77D21D4BD24 \
    DD792F5973C6DE52C432CBDAC77ABFA00DDBF2B7 \
    DD8F2338BAE7501E3DD5AC78C273792F7D83545D \
    EDC5FCAE2317BA6060FDB92C4708964F8085DFE7 \
    F097C42A7071A2F8E037AEF84FEC3ECC9B596CE2 \
    FD3A5288F042B6850C66B31F09FE44734EB7990E \
    FD95EE40161592AC9C1FCB48B2CCB982D6DCC25D \
    "


ENV PYENV_ROOT=/opt/pyenv

# Stable PATH for login/non‑login shells
ENV PATH=${PYENV_ROOT}/shims:${PYENV_ROOT}/bin:/opt/node/bin:$PATH
ENV PATH=$PATH:/root/.local/bin:/home/terrarium/.local/bin
ENV HOME=/home/terrarium

RUN echo "I am running on ${BUILDPLATFORM}, ${BUILDOS}, ${BUILDARCH}, ${BUILDVARIANT}, \
    building for ${TARGETPLATFORM}, ${TARGETOS}, ${TARGETARCH}, ${TARGETVARIANT}."

# OS update + dnf hardening
RUN . /etc/os-release && echo "Base image: $PRETTY_NAME" \
    && dnf -y upgrade \
    && dnf clean all
RUN printf '\nmax_parallel_downloads=10\nretries=10\ntsflags=nodocs\n' >> /etc/dnf/dnf.conf

# Base utils
#   ripgrep         — AI coding agents (Claude Code, Cursor) and `grep -r` power users
#                     expect `rg` for fast recursive search
#   util-linux-user — provides `chsh`, required by the devcontainer `common-utils`
#                     feature to change the default shell (e.g. to zsh)
#   ca-certificates — keep trust anchors up to date for curl / openssl fetches
#   libyaml-devel   — header package kept alongside `libyaml` so downstream images
#                     can rebuild native extensions (Python PyYAML)
#   nano            — the terminal editor; replaces vi/vim-minimal, which the
#                     slimdown step removes (INFIAAS-9587, see EDITOR below)
RUN dnf -y install dnf-plugins-core \
    && dnf config-manager --set-enabled ubi-9-codeready-builder-rpms \
    && dnf -y install https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    && dnf -y install jq parallel ripgrep util-linux-user ca-certificates libyaml-devel nano \
    && jq --version \
    && rg --version \
    && chsh --version \
    && nano --version \
    && dnf clean all
# git, visudo, crontab and friends fall back to `vi`, which is not in the image.
ENV EDITOR=nano \
    VISUAL=nano

ENV RUNTIME_PKGS="gcc gcc-c++ make git coreutils zlib zlib-devel unzip wget \
    bzip2 bzip2-devel xz xz-devel sqlite sqlite-devel libffi libffi-devel \
    openssl openssl-devel libuuid libyaml tk gdbm tar diffutils \
    autoconf automake libtool procps which sudo gnupg2"

RUN set -x \
    && (dnf -q list installed coreutils-single >/dev/null 2>&1 && dnf -y swap coreutils-single coreutils || dnf -y install coreutils --allowerasing) \
    && (dnf -q list installed curl-minimal >/dev/null 2>&1 && dnf -y swap curl-minimal curl || dnf -y install curl --allowerasing) \
    && dnf -y install $RUNTIME_PKGS \
    && dnf clean all

# Downloader + verification helpers now live in docker/files/bin/ as named,
# shellcheck-clean, unit-tested files (fetch, verify_gpg_signed_checksums,
# verify_gpg_detached, verify_sha256_from_url, verify_sha256_from_checksums).
# Installed here, before their first use by import_vendor_key and the tool
# installers below.
# See INFIAAS-11426.
COPY files/bin/ /usr/local/bin/

# Vendor-key import helper — now docker/files/bin/import_vendor_key, installed
# by the COPY above. Fetches a PGP public key, verifies it contains the pinned
# fingerprint, and installs it to a trusted keyring; fail-closed at every step,
# the trusted keyring written only once the pinned fingerprint is confirmed in
# a disposable temp keyring. See INFIAAS-11426.

# Keyrings (deterministic bootstrap)
RUN install -d -m 0755 /opt/keys/gpg /opt/keys/tmp

ENV GNUPGHOME=/opt/keys/gnupg
RUN install -d -m 0700 "$GNUPGHOME"

# HashiCorp security key
RUN import_vendor_key hashicorp "$HASHICORP_PGP_FPR" \
    "https://keys.openpgp.org/vks/v1/by-fingerprint/${HASHICORP_PGP_FPR}" \
    "https://www.hashicorp.com/.well-known/pgp-key.txt" \
    /opt/keys/hashicorp.asc /opt/keys/gpg/hashicorp.gpg

# OpenTofu release key — vendor URL is primary because keys.openpgp.org strips
# UIDs for this key (owner has not email-verified with that keyserver), and
# GPG refuses to import UID-less keys. Ubuntu keyserver preserves UIDs.
RUN import_vendor_key opentofu "$OPENTOFU_PGP_FPR" \
    "https://get.opentofu.org/opentofu.asc" \
    "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${OPENTOFU_PGP_FPR}" \
    /opt/keys/opentofu.asc /opt/keys/gpg/opentofu.gpg


# Node.js release keys — prefer curated keyring; fallback to per-fingerprint imports.
# Security model: the pinned NODE_RELEASE_FPRS allowlist is the trust anchor.
# Whatever the source (curated or fallback), only allowlisted fingerprints are
# promoted into the trusted final keyring. Fail-closed if none survive.
RUN import_node_keyring


# AWS CLI release key — vendor URL is primary because keys.openpgp.org strips
# UIDs for this key. See the comment on the OpenTofu block above. The helper
# auto-falls-back on UID-stripping, but starting from the vendor URL avoids a
# wasted request on every build.
RUN import_vendor_key awscli "$AWS_CLI_PGP_FPR" \
    "$AWS_CLI_PGP_URL" \
    "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x${AWS_CLI_PGP_FPR}" \
    /opt/keys/awscli.asc /opt/keys/gpg/awscli.gpg




# Show imported keys (optional, quiet)
RUN for name in hashicorp opentofu awscli node; do \
    gpg --batch --homedir "$GNUPGHOME" --no-default-keyring \
    --keyring "/opt/keys/gpg/${name}.gpg" \
    --list-keys --with-fingerprint --with-colons \
    | awk -F: -v n="$name" '/^fpr:/{print n ":", $10}'; \
    done


# ---- Bring in Python and xorriso compiled on Rocky ----
COPY --from=buildlang /opt/pyenv /opt/pyenv

# xorriso (from buildlang)
COPY --from=buildlang /usr/bin/xorriso /usr/bin/xorriso
COPY --from=buildlang /usr/lib64/libisoburn.so.* /usr/lib64/
COPY --from=buildlang /usr/lib64/libisofs.so.*  /usr/lib64/
COPY --from=buildlang /usr/lib64/libburn.so.*   /usr/lib64/
RUN /sbin/ldconfig || /usr/sbin/ldconfig || true

# ─── uv – ultra-fast dependency manager & Python launcher ───────────────────
RUN fetch https://astral.sh/uv/install.sh | bash && uv --version

# Configure PIP SSL validation
RUN pip config set global.cert /etc/ssl/certs/ca-bundle.crt \
    && pip config list

# ─── Python user‑level libraries via uv ─────────────────────────────────────
COPY pyproject.toml /tmp/pyproject.toml
COPY uv.lock       /tmp/uv.lock
# --no-cache (INFIAAS-9587): the uv cache in $HOME/.cache/uv is never used
# after this step but shipped wheel copies (uv itself, cryptography, PyJWT, …)
# that scanners report on top of the installed venv. Fail the build if a cache
# directory is still left behind.
RUN uv sync --directory /tmp --no-managed-python --frozen --no-cache \
    && test ! -e "${HOME}/.cache/uv"
ENV PATH=/tmp/.venv/bin:$PATH

# ─── Azure CLI (signed repo) ────────────────────────────────────────────────
RUN rpm --import https://packages.microsoft.com/keys/microsoft.asc \
    && dnf -y install https://packages.microsoft.com/config/rhel/9/packages-microsoft-prod.rpm \
    && dnf -y install azure-cli \
    && az --version \
    && dnf clean all

# ─── GCP CLI (Google Cloud SDK signed repo) ────────────────────────────────
RUN ARCH_GCP=$([[ "$TARGETARCH" == "amd64" ]] && echo "x86_64" || echo "aarch64") \
    && cat > /etc/yum.repos.d/google-cloud-sdk.repo <<EOF
[google-cloud-cli]
name=Google Cloud CLI
baseurl=https://packages.cloud.google.com/yum/repos/cloud-sdk-el9-${ARCH_GCP}
enabled=1
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://packages.cloud.google.com/yum/doc/rpm-package-key.gpg
EOF
RUN dnf -y install google-cloud-cli \
    && gcloud version \
    && dnf clean all

# AWS CLI (verify detached signature with AWS keyring)
RUN ARCH_SYNONYM=$([[ "$TARGETARCH" == "amd64" ]] && echo "x86_64" || echo "aarch64") \
    && FILE="awscliv2.zip" \
    && URL="https://awscli.amazonaws.com/awscli-exe-${TARGETOS}-${ARCH_SYNONYM}.zip" \
    && fetch -o "$FILE" "$URL" \
    && verify_gpg_detached /opt/keys/gpg/awscli.gpg "$FILE" "${URL}.sig" \
    && unzip -qq "$FILE" \
    && ./aws/install \
    && rm -rf aws "$FILE" \
    && /usr/local/bin/aws --version

# AWS SAM (x86_64: try detached sig; arm64: pip)
RUN if [ "x${TARGETARCH}" = "xamd64" ]; then \
    FILE="aws-sam-cli-${TARGETOS}-x86_64.zip"; \
    BASE="https://github.com/aws/aws-sam-cli/releases/latest/download"; \
    fetch -o "$FILE" "${BASE}/${FILE}"; \
    ( verify_gpg_detached /opt/keys/gpg/awscli.gpg "$FILE" "${BASE}/${FILE}.sig" || echo "WARN: SAM signature not found; continuing" ); \
    unzip -qq -d awssam "$FILE" && ./awssam/install && rm -rf awssam "$FILE"; \
    else \
    pip install --no-cache-dir aws-sam-cli; \
    fi \
    && sam --version


# Node.js + signed SHASUMS verification + npm (pinned, registry-integrity-checked) + AWS CDK
RUN ARCH_NODE=$([[ "$TARGETARCH" == "amd64" ]] && echo "x64" || echo "arm64") \
    && VER="${NODEJS_VERSION}" \
    && BASE="https://nodejs.org/dist/v${VER}" \
    && FILE="node-v${VER}-${TARGETOS}-${ARCH_NODE}.tar.xz" \
    && fetch -o "$FILE" "${BASE}/${FILE}" \
    && verify_gpg_signed_checksums /opt/keys/gpg/node.gpg \
    "${BASE}/SHASUMS256.txt" "${BASE}/SHASUMS256.txt.sig" "$FILE" \
    && xzcat "$FILE" | tar xpf - -C /opt/ \
    && mv "/opt/node-v${VER}-${TARGETOS}-${ARCH_NODE}" /opt/node \
    && rm -f "$FILE" \
    && /opt/node/bin/npm install -g "npm@${NPM_VERSION}" \
    && /opt/node/bin/npm install -g aws-cdk@${AWS_CDK_VERSION} \
    && chown -R 1001:0 /opt/node && chmod +x /opt/node/bin/* \
    && node --version && cdk --version

# npm's own bundled dependencies (e.g. undici) lag their fixes even in the
# newest npm; swap in the fixed releases, registry-integrity-checked by npm pack.
RUN npm_patch_bundled ${NPM_BUNDLED_PATCHES} \
    && chown -R 1001:0 /opt/node/lib/node_modules/npm/node_modules \
    && npm --version


# tenv + Terraform + OpenTofu
# Point tenv at the locally pinned vendor keys (already fingerprint-verified
# at /opt/keys/*.asc) so tenv does not re-fetch upstream key endpoints at
# build time, which has tripped on upstream key expiration / rotation.
#
# tenv 4.11.0 shipped the "Fix PGP signature check" that makes tenv select
# the valid (non-expired) signing subkey from HashiCorp's key pack.
# HashiCorp's original signing subkey B0B441097685B676 expired 2022-04-19;
# the newer subkey C820C6D5CD27AB87 (valid through 2030) must be preferred,
# and only tenv >= 4.11.0 does this reliably.
#
# Cache invalidation note: TENV_VERSION / TERRAFORM_VERSION / OPENTOFU_VERSION
# must be passed as --build-arg by the CI workflows (see .github/workflows/*)
# so buildkit's cache-from treats version bumps as a cache-key change.
# Without that, stale cached layers built with older versions can satisfy
# cache-from hits even after the Dockerfile ARG defaults are bumped.
#
# tenv RPM integrity (INFIAAS-11804): the RPM is SHA-256-verified against the
# release's checksums file before install (it was installed unverified).
#
# GitHub API rate limit (INFIAAS-11804): `tenv tofu install` resolves the
# OpenTofu release through api.github.com, which allows 60 anonymous requests
# per hour per IP, and CI runners share IPs. CI passes the job's GITHUB_TOKEN
# (the build jobs hold no contents:write) as the BuildKit secret
# `tenv_github_token`, handed to that one command only. It is never an ARG/ENV,
# so it isn't in any layer, the cache key or the image. With no secret (forks,
# local builds) tenv runs anonymously, as before.
RUN --mount=type=secret,id=tenv_github_token,required=false \
    TENV_ARCH=$([[ "$TARGETARCH" == "amd64" ]] && echo "amd64" || echo "arm64") \
    && TENV_BASE="https://github.com/tofuutils/tenv/releases/download/v${TENV_VERSION}" && TENV_RPM="/tmp/tenv_v${TENV_VERSION}_${TENV_ARCH}.rpm" \
    && fetch -o "$TENV_RPM" "${TENV_BASE}/$(basename "$TENV_RPM")" \
    && verify_sha256_from_checksums "${TENV_BASE}/tenv_v${TENV_VERSION}_checksums.txt" "$TENV_RPM" \
    && dnf -y install "$TENV_RPM" && rm -f "$TENV_RPM" \
    && export TFENV_HASHICORP_PGP_KEY=/opt/keys/hashicorp.asc \
    && export TOFUENV_OPENTOFU_PGP_KEY=/opt/keys/opentofu.asc \
    && echo "tenv version: $(tenv --version)" \
    && echo "Using TFENV_HASHICORP_PGP_KEY=${TFENV_HASHICORP_PGP_KEY}" \
    && echo "Using TOFUENV_OPENTOFU_PGP_KEY=${TOFUENV_OPENTOFU_PGP_KEY}" \
    && tenv tf install ${TERRAFORM_VERSION} \
    && tenv tf use ${TERRAFORM_VERSION} \
    && terraform -version \
    && if [ -s /run/secrets/tenv_github_token ]; then \
    TENV_GITHUB_TOKEN="$(cat /run/secrets/tenv_github_token)" tenv tofu install ${OPENTOFU_VERSION}; \
    else tenv tofu install ${OPENTOFU_VERSION}; fi \
    && tenv tofu use ${OPENTOFU_VERSION} \
    && tofu -version \
    && chown -R 1001:0 "${TENV_ROOT}" && chmod -R 2775 "${TENV_ROOT}"

# Safe tenv profile
RUN cat > /etc/profile.d/tenv.sh <<'EOF'
if command -v tenv >/dev/null 2>&1; then
  if tenv --help 2>&1 | grep -q 'update-path'; then
    TENV_NEW_PATH="$((/usr/bin/tenv update-path) 2>/dev/null || true)"
    if [ -n "$TENV_NEW_PATH" ]; then
      case ":$PATH:" in *":$TENV_NEW_PATH:"*) : ;; *) PATH="$TENV_NEW_PATH:$PATH" ;; esac
    fi
  elif tenv --help 2>&1 | grep -q 'init'; then
    eval "$(/usr/bin/tenv init - bash 2>/dev/null)" || true
  fi
fi
export PATH
EOF

# HashiCorp tools — verify signed checksums
RUN ARCH=$([[ "$TARGETARCH" == "amd64" ]] && echo "amd64" || echo "arm64") \
    && VER="${PACKER_VERSION}" && BASE="https://releases.hashicorp.com/packer/${VER}" \
    && FILE="/tmp/packer_${VER}_${TARGETOS}_${ARCH}.zip" \
    && fetch -o "$FILE" "${BASE}/packer_${VER}_${TARGETOS}_${ARCH}.zip" \
    && verify_gpg_signed_checksums /opt/keys/gpg/hashicorp.gpg "${BASE}/packer_${VER}_SHA256SUMS" "${BASE}/packer_${VER}_SHA256SUMS.sig" "$FILE" \
    && unzip -qq "$FILE" -d /usr/local/bin packer \
    && rm -f "$FILE" \
    && packer --version

# starship — download binary directly and verify checksum
RUN set -eux; \
    ARCH=$([[ "$TARGETARCH" = "amd64" ]] && echo "x86_64" || echo "aarch64"); \
    BASE="https://github.com/starship/starship/releases/download/v${STARSHIP_VERSION}"; \
    FNAME="starship-${ARCH}-unknown-linux-musl.tar.gz"; \
    fetch -o "/tmp/${FNAME}" "${BASE}/${FNAME}" \
    && verify_sha256_from_url "${BASE}/${FNAME}.sha256" "/tmp/${FNAME}" \
    && tar -xzf "/tmp/${FNAME}" -C /usr/local/bin starship \
    && rm -f "/tmp/${FNAME}" \
    && starship --version

# zoxide — download pinned binary directly from GitHub releases
# Note: zoxide does not publish checksums; direct download is still safer than
# piping through webinstall.dev. TODO: add checksum verification when available.
RUN set -eux; \
    ARCH=$([[ "$TARGETARCH" = "amd64" ]] && echo "x86_64" || echo "aarch64"); \
    BASE="https://github.com/ajeetdsouza/zoxide/releases/download/v${ZOXIDE_VERSION}"; \
    FNAME="zoxide-${ZOXIDE_VERSION}-${ARCH}-unknown-linux-musl.tar.gz"; \
    fetch -o "/tmp/${FNAME}" "${BASE}/${FNAME}" \
    && tar -xzf "/tmp/${FNAME}" -C /usr/local/bin zoxide \
    && rm -f "/tmp/${FNAME}" \
    && zoxide --version

# Default starship config — downstream images can override by copying their
# own starship.toml to ~/.config/starship.toml
RUN mkdir -p ${HOME}/.config \
    && chown -R 1001:0 ${HOME}/.config
COPY files/starship.toml ${HOME}/.config/starship.toml
RUN chown 1001:0 ${HOME}/.config/starship.toml

# Go toolchain + go-task (robust checksum + JSON fallback)
RUN set -eux; \
    ARCH=$([ "$TARGETARCH" = "amd64" ] && echo amd64 || echo arm64); \
    TARBALL="go${GO_VERSION}.${TARGETOS}-${ARCH}.tar.gz"; \
    BASE="https://go.dev/dl"; \
    fetch -o "/tmp/${TARBALL}" "${BASE}/${TARBALL}"; \
    # First try the straightforward .sha256 file
    if ! verify_sha256_from_url "${BASE}/${TARBALL}.sha256" "/tmp/${TARBALL}"; then \
    echo "WARN: ${TARBALL}.sha256 not usable; falling back to Go JSON index"; \
    fetch -o /tmp/go.json "${BASE}/?mode=json&include=all"; \
    SUM="$(jq -r --arg v "go${GO_VERSION}" --arg os "${TARGETOS}" --arg arch "${ARCH}" \
    '.[] | select(.version==$v) \
    | .files[] | select(.kind=="archive" and .os==$os and .arch==$arch) \
    | .sha256' /tmp/go.json)"; \
    [ -n "$SUM" ] || { echo "ERROR: could not obtain checksum for ${TARBALL}"; exit 1; }; \
    echo "${SUM}  /tmp/${TARBALL}" | sha256sum -c -; \
    fi; \
    tar -C /usr/local -xzf "/tmp/${TARBALL}"; \
    rm -f "/tmp/${TARBALL}" /tmp/go.json || true
ENV PATH=$PATH:/usr/local/go/bin

# go-task
RUN fetch https://taskfile.dev/install.sh | sh -s -- -d v${TASK_VERSION} \
    && task --version



# sops — install the signed RPM (short, self-contained)
RUN ARCH_RPM=$([[ "$TARGETARCH" = "amd64" ]] && echo "x86_64" || echo "aarch64"); \
    dnf -y install "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-${SOPS_VERSION}-1.${ARCH_RPM}.rpm" \
    && /usr/bin/sops --version \
    && dnf clean all

# age — download, verify, install (helper: docker/files/bin/install_age)
RUN install_age


# yq
RUN TARGETARCH_SYNONYM_SHORT2=$([[ "$TARGETARCH" == "amd64" ]] && echo "amd64" || echo "arm64") \
    && fetch -o /usr/local/bin/yq "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_${TARGETARCH_SYNONYM_SHORT2}" \
    && chmod +x /usr/local/bin/yq \
    && /usr/local/bin/yq --version

# kubectl — verify sha256 file
RUN ARCH=$([[ "$TARGETARCH" == "amd64" ]] && echo "amd64" || echo "arm64") \
    && VER="v${KUBECTL_VERSION}" \
    && URL="https://dl.k8s.io/release/${VER}/bin/linux/${ARCH}/kubectl" \
    && fetch -o /usr/local/bin/kubectl "$URL" \
    && chmod +x /usr/local/bin/kubectl \
    && verify_sha256_from_url "${URL}.sha256" "/usr/local/bin/kubectl" \
    && kubectl version --client=true

# helm — verify sha256sum file
RUN ARCH=$([[ "$TARGETARCH" == "amd64" ]] && echo "amd64" || echo "arm64") \
    && VER="v${HELM_VERSION}" \
    && FILE="/tmp/helm-${VER}-linux-${ARCH}.tar.gz" \
    && BASE="https://get.helm.sh" \
    && fetch -o "$FILE" "${BASE}/helm-${VER}-linux-${ARCH}.tar.gz" \
    && verify_sha256_from_url "${BASE}/helm-${VER}-linux-${ARCH}.tar.gz.sha256sum" "$FILE" \
    && tar -zxvf "$FILE" --strip-components=1 -C /usr/local/bin "linux-${ARCH}/helm" \
    && rm -f "$FILE" \
    && helm version

# Terraform Docs
RUN TARGETARCH_SYNONYM_SHORT2=$([[ "$TARGETARCH" == "amd64" ]] && echo "amd64" || echo "arm64") \
    && fetch -o /tmp/terraform-docs.tar.gz "https://github.com/terraform-docs/terraform-docs/releases/download/${TERRAFORM_DOCS_VERSION}/terraform-docs-${TERRAFORM_DOCS_VERSION}-${TARGETOS}-${TARGETARCH_SYNONYM_SHORT2}.tar.gz" \
    && tar zxpf /tmp/terraform-docs.tar.gz -C /usr/local/bin/ terraform-docs \
    && rm -f /tmp/terraform-docs.tar.gz \
    && chmod +x /usr/local/bin/terraform-docs \
    && /usr/local/bin/terraform-docs --help


# tflint — verify from checksums.txt
RUN ARCH=$([[ "$TARGETARCH" == "amd64" ]] && echo "amd64" || echo "arm64") \
    && BASE="https://github.com/terraform-linters/tflint/releases/download/v${TFLINT_VERSION}" \
    && FILE="/tmp/tflint_linux_${ARCH}.zip" \
    && fetch -o "$FILE" "${BASE}/tflint_linux_${ARCH}.zip" \
    && verify_sha256_from_checksums "${BASE}/checksums.txt" "$FILE" \
    && unzip -qq "$FILE" -d /usr/local/bin \
    && rm -f "$FILE" \
    && tflint --version

# --- Trivy (IaC security scanner, replaces deprecated tfsec) ------------------
# Download binary directly and verify checksum instead of curl-pipe-to-shell
RUN set -eux; \
    ARCH=$([[ "$TARGETARCH" = "amd64" ]] && echo "64bit" || echo "ARM64"); \
    BASE="https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}"; \
    FNAME="trivy_${TRIVY_VERSION}_Linux-${ARCH}.tar.gz"; \
    fetch -o "/tmp/${FNAME}" "${BASE}/${FNAME}" \
    && verify_sha256_from_checksums "${BASE}/trivy_${TRIVY_VERSION}_checksums.txt" "/tmp/${FNAME}" \
    && tar -xzf "/tmp/${FNAME}" -C /usr/local/bin trivy \
    && rm -f "/tmp/${FNAME}" \
    && trivy version

# --- OpenShift CLI (oc) ------------------------------------------------------
RUN arch="${TARGETARCH:-$(echo "${TARGETPLATFORM:-linux/amd64}" | cut -d/ -f2)}" \
    && fetch -o /tmp/oc.tgz \
    "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/${OC_VERSION}/openshift-client-linux-${arch}-rhel9.tar.gz" \
    && tar -C /usr/local/bin -xzf /tmp/oc.tgz oc \
    && rm -f /tmp/oc.tgz \
    && oc version --client

# --- OpenStack CLI -----------------------------------------------------------
# Versions should match upper constraints https://opendev.org/openstack/requirements/src/branch/stable/${OPENSTACK_RELEASE}/upper-constraints.txt
RUN python -m venv ${OPENSTACK_VENV} \
    && ${OPENSTACK_VENV}/bin/pip install --no-cache-dir \
    python-openstackclient \
    python-barbicanclient \
    --constraint https://opendev.org/openstack/requirements/raw/branch/stable/${OPENSTACK_RELEASE}/upper-constraints.txt \
    && ln -s ${OPENSTACK_VENV}/bin/openstack /usr/local/bin/openstack \
    && openstack --version

# --- NPM per-user prefix (avoids sudo for global installs) -------------------
RUN rm -rf ${HOME}/.npm ${HOME}/.npm-global \
    && install -d -m 0755 -o 1001 -g 0 \
    ${HOME}/.npm \
    ${HOME}/.npm-global \
    ${HOME}/.npm-global/bin \
    && printf 'prefix=%s\ncache=%s\n' \
    "${HOME}/.npm-global" "${HOME}/.npm" \
    > ${HOME}/.npmrc \
    && chown 1001:0 ${HOME}/.npmrc
ENV PATH="${HOME}/.npm-global/bin:${PATH}"

# --- Shell init (zoxide, starship, local bins) --------------------------------
RUN echo 'eval "$(zoxide init bash)"' >> "${HOME}/.bashrc" \
    && echo 'eval "$(starship init bash)"' >> "${HOME}/.bashrc" \
    && echo 'export PATH="$HOME/.local/bin:$PATH"' >> "${HOME}/.bashrc"

# --- Persistent bash history (after shell init to append to PROMPT_COMMAND) ---
RUN mkdir -p /commandhistory \
    && touch /commandhistory/.bash_history \
    && chown -R 1001:0 /commandhistory \
    && { \
    echo 'export HISTFILE=/commandhistory/.bash_history'; \
    echo 'if [ -n "$PROMPT_COMMAND" ]; then'; \
    echo '  PROMPT_COMMAND="$PROMPT_COMMAND;history -a"'; \
    echo 'else'; \
    echo '  PROMPT_COMMAND="history -a"'; \
    echo 'fi'; \
    } >> "${HOME}/.bashrc"

# ─── UID‑agnostic toolchains: create stable devtools group and set perms ─────
RUN groupadd -g ${DEVTOOLS_GID} devtools || true \
    && install -d -m 0775 -o 1001 -g devtools "${HOME}"

# Set devtools group ownership on tool directories
RUN chgrp -R devtools /opt/pyenv \
    && find /opt/pyenv -type d -exec chmod 2775 {} + \
    && find /opt/pyenv -type f -exec chmod g+rw {} + \
    && find /opt/pyenv -type f -perm -u=x -exec chmod g+x {} +

RUN chgrp -R devtools /opt/tenv \
    && find /opt/tenv -type d -exec chmod 2775 {} + \
    && find /opt/tenv -type f -exec chmod g+rw {} + \
    && find /opt/tenv -type f -perm -u=x -exec chmod g+x {} +

# Ownerships & dirs
RUN chown -R 1001:0 ${HOME} && chmod -R g+rw ${HOME} \
    && ls -lisa ${HOME}

# bats-core for tests (single install)
RUN set -eux; \
    rm -rf /opt/bats-core; \
    git clone --depth 1 --branch "v${BATS_CORE_VERSION}" \
    https://github.com/bats-core/bats-core.git /opt/bats-core; \
    /opt/bats-core/install.sh /usr/local; \
    rm -rf /opt/bats-core; \
    bats --version

# --- Redirect GNUPGHOME to ~/.gnupg so VS Code UID remapping works -----------
# Build-time GNUPGHOME=/opt/keys/gnupg is mode 0700. When updateRemoteUserUID
# remaps the UID, /opt/keys/gnupg becomes inaccessible. Redirect to ~/.gnupg
# which lives under $HOME and follows the UID remap automatically.
RUN install -d -m 0700 -o 1001 -g 0 /home/terrarium/.gnupg
ENV GNUPGHOME=/home/terrarium/.gnupg

# --- Image slimdown: remove build-only deps, docs, and locale data -----------
# Build deps (gcc, *-devel, etc.) from RUNTIME_PKGS are only needed while the
# image is built. They are not needed at runtime — consumers use the pre-built
# Python interpreter from the buildlang stage.
# Savings: ~210 MB (build deps) + ~138 MB (docs/man/locale) ≈ 350 MB.
# vim-minimal and gdb-gdbserver come from the UBI base, nothing requires them,
# and they carry 76 + 11 High CVEs that Red Hat has not fixed (INFIAAS-9587,
# decision D5). Enhanced vim shares the same CVEs, so it is no substitute;
# nano is the editor. The rpm -q guards fail the build if either returns
# (one per package: `rpm -q a b` is non-zero if EITHER is missing).
RUN set -eux \
    && dnf -y remove gcc gcc-c++ cpp binutils autoconf automake libtool \
    kernel-headers glibc-devel libstdc++-devel \
    openssl-devel bzip2-devel libffi-devel sqlite-devel \
    xz-devel zlib-devel libxcrypt-devel \
    vim-minimal gdb-gdbserver \
    && dnf -y autoremove \
    && ! rpm -q vim-minimal && ! rpm -q gdb-gdbserver \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && rm -rf /usr/share/doc /usr/share/man /usr/share/info \
    && find /usr/share/locale -mindepth 1 -maxdepth 1 ! -name 'en_US' -exec rm -rf {} + \
    && rm -rf /usr/lib/locale/locale-archive.tmpl \
    && rm -rf /opt/keys/tmp

# --- User & group setup (must be in builder so published image includes them) ---
ARG DEVTOOLS_GID=2001
RUN groupadd -g ${DEVTOOLS_GID} devtools || true \
    && useradd -u 1001 -d /home/terrarium -s /bin/bash terrarium || true \
    && usermod -aG devtools terrarium

# --- Tests & test helpers (ship in published image for runtime health checks) ---
COPY tests /home/terrarium/tests
RUN install -d -m 0755 /home/terrarium/tests/test_helper \
    && rm -rf /home/terrarium/tests/test_helper/bats-support /home/terrarium/tests/test_helper/bats-assert \
    && git clone --depth 1 https://github.com/bats-core/bats-support.git /home/terrarium/tests/test_helper/bats-support \
    && git clone --depth 1 https://github.com/bats-core/bats-assert.git   /home/terrarium/tests/test_helper/bats-assert
RUN find /home/terrarium/tests -type f -name "*.bats" -exec chmod +x {} \; \
    && chown -R terrarium:devtools /home/terrarium/tests

WORKDIR $HOME
CMD ["/bin/bash", "-i", "-l"]

# ================= Stage — helpers (hermetic unit tests for docker/files/bin) =================
# Deliberately NOT in `builder`'s dependency chain (INFIAAS-11426 decision 5):
# `builder` already COPYs files/bin/, so a helper edit invalidates it regardless
# — welding `helpers` in would only inject the unit suite into every
# `--target test` build (including downstream E2E and release) for no cache
# benefit. CI runs this stage explicitly, before the main build, so it still
# fails fast. Runs with bats core only; no network, nothing outside tmpdir.
FROM registry.access.redhat.com/ubi9/ubi:${UBI9_VERSION} AS helpers
ARG BATS_CORE_VERSION
# Only `git` is missing from the ubi9 base (needed to clone bats). bash, gnupg2
# and the coreutils multicall (via coreutils-single: cat/head/sha256sum/…) are
# already present; installing `coreutils` would conflict with coreutils-single.
RUN dnf -y install --setopt=install_weak_deps=False git \
    && dnf clean all && rm -rf /var/cache/dnf
RUN git clone --depth 1 --branch "v${BATS_CORE_VERSION}" \
      https://github.com/bats-core/bats-core /tmp/bats \
    && /tmp/bats/install.sh /usr/local && rm -rf /tmp/bats
COPY files/bin/ /usr/local/bin/
COPY tests/unit /opt/unit
RUN bats /opt/unit

# ================= Stage 2 — test (build-time gate, also the publish target) =================
# `test` is the last stage by design: the bats suite is intentionally shipped
# so consumers can re-run it against a running container (see README
# "Test an already-built image"). CI workflows publish --target test.
FROM builder AS test
USER terrarium
RUN bats --report-formatter junit /home/terrarium/tests --output /home/terrarium --jobs $(nproc)
